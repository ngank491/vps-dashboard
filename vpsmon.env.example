# Cấu hình vpsmon — install.sh sao chép file này thành /etc/vpsmon/vpsmon.env (nếu chưa có).
# Sửa xong chạy:  sudo systemctl restart vpsmon
# Thay đổi các dòng VPSMON_TCP_IGNORE / VPSMON_UDP_IGNORE / VPSMON_NFLOG_GROUP / VPSMON_WAN_IF
# thì chạy lại:   sudo ./install.sh   (để cập nhật luật firewalld)

# Địa chỉ web nội bộ. Giữ 127.0.0.1 và đặt sau reverse proxy có giới hạn truy cập.
VPSMON_LISTEN=127.0.0.1:8790

# Card mạng ra Internet. Để trống = tự lấy card của default route.
VPSMON_WAN_IF=

# Cổng KHÔNG ghi nhận là "quét" (cổng dịch vụ công khai hợp lệ, ví dụ web). Tối đa 15 cổng mỗi dòng.
# Cổng proxy KHÔNG đưa vào đây (để còn đếm kết nối vào proxy).
VPSMON_TCP_IGNORE=80,443
VPSMON_UDP_IGNORE=443

# Nhóm NFLOG dùng để nhận gói tin từ firewalld (1-65535, không trùng phần mềm khác).
VPSMON_NFLOG_GROUP=7

# Proxy cần theo dõi: cổng:nhãn, cách nhau dấu phẩy.
VPSMON_PROXY_PORTS=21080:SOCKS5,23128:HTTP
# systemd unit của proxy (đọc log lỗi xác thực của gost v3). Để trống = tắt.
VPSMON_PROXY_UNIT=gost
# User chạy proxy (đếm số kết nối proxy đang mở ra Internet). Mặc định = tên unit.
VPSMON_PROXY_USER=

# Dịch vụ chính hiển thị đầu bảng (unit không tồn tại sẽ tự ẩn). Có thể ghi .socket / .automount.
VPSMON_SERVICES=sshd,firewalld,crond,chronyd,gost,caddy,tailscaled,wg-quick@wg0

# IP public của VPS nếu VPS nằm sau NAT (Oracle Cloud, AWS, GCP…) để nút Chặn không chặn nhầm chính mình.
# Các IP trên card mạng của máy đã được tự thêm.
VPSMON_OWN_IPS=

# Interface WireGuard cần hiển thị.
VPSMON_WG_IFACE=wg0

# Thư mục ổ mạng (NAS…) cần theo dõi dung lượng. Để trống = tắt.
VPSMON_NAS_PATH=

# Chứng chỉ HTTPS cần theo dõi ngày hết hạn (mặc định: chứng chỉ do Caddy quản lý).
VPSMON_CERT_GLOB=/var/lib/caddy/.local/share/caddy/certificates/*/*/*.crt

# Hiện quốc gia cạnh IP (tự tải DB-IP Country Lite ~8 MB, cập nhật hằng tháng). 0 = tắt.
VPSMON_GEOIP=1

# Nơi lưu dữ liệu (SQLite + GeoIP).
VPSMON_DB=/var/lib/vpsmon/vpsmon.db
