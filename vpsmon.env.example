# vpsmon config — install.sh copies this file to /etc/vpsmon/vpsmon.env (if it does not exist yet).
# Cấu hình vpsmon — install.sh sao chép file này thành /etc/vpsmon/vpsmon.env (nếu chưa có).
#
# After editing / Sửa xong:            sudo systemctl restart vpsmon
# After changing TCP_IGNORE / UDP_IGNORE / NFLOG_GROUP / WAN_IF, re-run (updates firewalld rules):
# Đổi TCP_IGNORE / UDP_IGNORE / NFLOG_GROUP / WAN_IF thì chạy lại:   sudo ./install.sh

# Web address. Keep 127.0.0.1 and put it behind an access-restricted reverse proxy.
# Địa chỉ web nội bộ. Giữ 127.0.0.1 và đặt sau reverse proxy có giới hạn truy cập.
VPSMON_LISTEN=127.0.0.1:8790

# Internet-facing interface. Empty = interface of the default route.
# Card mạng ra Internet. Để trống = tự lấy card của default route.
VPSMON_WAN_IF=

# Ports NOT counted as "scans" (legitimate public services, e.g. web). Max 15 ports per line.
# Do not list your proxy ports here (they are counted separately).
# Cổng KHÔNG tính là "quét" (dịch vụ công khai hợp lệ, ví dụ web). Tối đa 15 cổng mỗi dòng.
# Không đưa cổng proxy vào đây (để còn đếm kết nối vào proxy).
VPSMON_TCP_IGNORE=80,443
VPSMON_UDP_IGNORE=443

# NFLOG group used to receive packets from firewalld (1-65535, must not clash with other software).
# Nhóm NFLOG nhận gói tin từ firewalld (1-65535, không trùng phần mềm khác).
VPSMON_NFLOG_GROUP=7

# Proxy ports to watch: port:label, comma-separated.
# Cổng proxy cần theo dõi: cổng:nhãn, cách nhau dấu phẩy.
VPSMON_PROXY_PORTS=21080:SOCKS5,23128:HTTP
# systemd unit of the proxy (reads gost v3 auth-failure logs). Empty = disabled.
# systemd unit của proxy (đọc log lỗi xác thực của gost v3). Để trống = tắt.
VPSMON_PROXY_UNIT=gost
# User running the proxy (counts its outbound connections). Default = unit name.
# User chạy proxy (đếm kết nối proxy đang mở ra Internet). Mặc định = tên unit.
VPSMON_PROXY_USER=

# Main services shown first (units that do not exist are hidden). .socket / .automount allowed.
# Dịch vụ chính hiển thị đầu bảng (unit không tồn tại sẽ tự ẩn). Có thể ghi .socket / .automount.
VPSMON_SERVICES=sshd,firewalld,crond,chronyd,gost,caddy,tailscaled,wg-quick@wg0

# Public IP of the VPS when it sits behind NAT (Oracle Cloud, AWS, GCP…), so the Block button
# never blocks the VPS itself. Addresses on the machine's interfaces are added automatically.
# IP public của VPS nếu VPS nằm sau NAT (Oracle Cloud, AWS, GCP…) để nút Chặn không chặn nhầm chính mình.
# Các IP trên card mạng của máy đã được tự thêm.
VPSMON_OWN_IPS=

# WireGuard interface to display. / Interface WireGuard cần hiển thị.
VPSMON_WG_IFACE=wg0

# Network drive (NAS…) mount point to monitor. Empty = disabled.
# Thư mục ổ mạng (NAS…) cần theo dõi dung lượng. Để trống = tắt.
VPSMON_NAS_PATH=

# HTTPS certificates to watch for expiry (default: certificates managed by Caddy).
# Chứng chỉ HTTPS cần theo dõi ngày hết hạn (mặc định: chứng chỉ do Caddy quản lý).
VPSMON_CERT_GLOB=/var/lib/caddy/.local/share/caddy/certificates/*/*/*.crt

# Show the country next to IPs (downloads DB-IP Country Lite ~8 MB, refreshed monthly). 0 = off.
# Hiện quốc gia cạnh IP (tự tải DB-IP Country Lite ~8 MB, cập nhật hằng tháng). 0 = tắt.
VPSMON_GEOIP=1

# Data location (SQLite + GeoIP). / Nơi lưu dữ liệu (SQLite + GeoIP).
VPSMON_DB=/var/lib/vpsmon/vpsmon.db
